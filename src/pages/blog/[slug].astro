---
import Base from '../../layouts/Base.astro';
import { Header } from '../../components/site/header';
import { Footer } from '../../components/site/sections';
import { BlogDetail } from '../../components/site/blog-detail';
import { ALL_POSTS, type BlogPost } from '../../lib/blog-data';

export function getStaticPaths() {
  return ALL_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<Base
  title={`${post.title} — Noruva Labs Blog`}
  description={post.body}
>
  <div class="min-h-screen overflow-x-clip bg-paper">
    <Header client:load />
    <BlogDetail client:load slug={post.slug} />
    <Footer client:load />
  </div>
</Base>
