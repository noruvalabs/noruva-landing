---
import Base from '../../layouts/Base.astro';
import { Header } from '../../components/site/header';
import { Footer } from '../../components/site/sections';
import { ArrowRight, Plane, MapPin, FileCheck, Clock } from 'lucide-react';

const FEATURES = [
  {
    icon: "MapPin",
    title: "Route eligibility",
    body: "Answer eligibility questions and map the applicant to the right visa route. No more guesswork on which path to take.",
  },
  {
    icon: "FileCheck",
    title: "Evidence checklists",
    body: "Generate the exact evidence checklist for each route. Missing or expiring documents surface before they become a refusal.",
  },
  {
    icon: "Clock",
    title: "Deadline tracking",
    body: "Track deadlines across a whole caseload. Never miss a filing date or renewal window again.",
  },
  {
    icon: "Plane",
    title: "Case management",
    body: "Manage multiple cases from one dashboard. Status updates, document links and next steps at a glance.",
  },
];

const STEPS = [
  { n: "01", title: "Intake the applicant", body: "Answer a few questions about the applicant's situation, nationality, and goals." },
  { n: "02", title: "Match the route", body: "The assistant identifies the best visa route and explains the requirements." },
  { n: "03", title: "Build the checklist", body: "Generate a document checklist with expiry tracking and missing item alerts." },
  { n: "04", title: "Track and file", body: "Monitor deadlines, upload documents, and prepare the final submission package." },
];
---

<Base
  title="Torii Immigration Assistant — Noruva Labs"
  description="File your visa application correctly — for a fraction of a lawyer's fee. Branching intake, personalized document checklists, auto-filled government forms."
>
  <div class="min-h-screen overflow-x-clip bg-gradient-to-b from-blue-50/60 via-paper to-paper">
    <Header client:load />
    <main class="relative vertical-lines">
      <!-- Hero -->
      <section class="relative overflow-hidden pt-32 pb-20">
        <div class="pointer-events-none absolute inset-0 glow-purple" />
        <div class="container-page relative">
          <span class="inline-flex items-center gap-2 rounded-full bg-blue-100 border border-blue-300 px-3.5 py-1 font-inter text-caption font-bold text-blue-800 shadow-xs">
            <Plane class="h-3.5 w-3.5 text-blue-600" />
            Torii Immigration Suite (Coming Soon)
          </span>
          <h1 class="mt-5 text-[34px] leading-[1.1] tracking-tight text-graphite sm:text-[44px] md:text-heading-lg lg:text-display font-bold font-cal">
            File your visa application <span class="italic text-blue-600 font-serif">correctly.</span>
          </h1>
          <p class="mt-6 max-w-lg text-subheading text-slate leading-relaxed">
            Torii walks you from "which forms do I even need?" to a submission-ready packet: a branching intake,
            a personalized document checklist, and auto-filled government forms — for a fraction of a lawyer's fee.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#cta" class="btn-pill bg-blue-600 text-white hover:bg-blue-500 shadow-md font-bold">
              Start Your Case <ArrowRight class="h-4 w-4" />
            </a>
            <a href="#features" class="btn-pill btn-ghost font-semibold">
              See features
            </a>
          </div>
        </div>
      </section>

      <div class="section-separator w-full" />

      <!-- Features -->
      <section id="features" class="container-page py-16 md:py-24">
        <div class="max-w-xl">
          <span class="inline-block rounded-full bg-blue-100 border border-blue-300 px-3 py-1 font-inter text-caption tracking-[0.08em] text-blue-800 uppercase font-bold">
            Features
          </span>
          <h2 class="mt-4 text-[28px] leading-[1.1] tracking-[0.4px] text-graphite sm:text-[36px] md:text-heading-lg font-bold font-cal">
            Never miss a
            <br />
            document or deadline
          </h2>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2">
          {FEATURES.map((f) => (
            <article class="card-surface p-6 border-blue-200/80 bg-gradient-to-br from-blue-50/50 via-white to-indigo-50/30 hover:shadow-xl transition-all">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 border border-blue-300">
                <Plane class="h-4.5 w-4.5 text-blue-700" />
              </div>
              <h3 class="mt-4 text-heading-sm font-bold font-cal text-graphite">{f.title}</h3>
              <p class="mt-1.5 text-body-sm text-slate">{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <div class="section-separator w-full" />

      <!-- How it works -->
      <section class="container-page py-16 md:py-24">
        <div class="max-w-xl">
          <span class="inline-block rounded-full bg-blue-100 border border-blue-300 px-3 py-1 font-inter text-caption tracking-[0.08em] text-blue-800 uppercase font-bold">
            How it works
          </span>
          <h2 class="mt-4 text-[28px] leading-[1.1] tracking-[0.4px] text-graphite sm:text-[36px] md:text-heading-lg font-bold font-cal">
            Four steps to
            <br />
            cleaner cases
          </h2>
        </div>
        <div class="mt-12 space-y-4">
          {STEPS.map((s) => (
            <article class="card-surface grid gap-6 p-6 md:grid-cols-[60px_1fr] border-blue-200/80 bg-white">
              <span class="font-cal text-heading-lg text-blue-600 font-extrabold">{s.n}</span>
              <div>
                <h3 class="text-heading font-bold font-cal text-graphite">{s.title}</h3>
                <p class="mt-2 text-body text-slate">{s.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <div class="section-separator w-full" />

      <!-- CTA -->
      <section id="cta" class="container-page pb-16 md:pb-24">
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-blue-950 via-indigo-900 to-slate-900 border border-blue-800 px-5 py-14 text-center text-white shadow-2xl sm:px-6 sm:py-20">
          <div class="relative z-10">
            <h2 class="mx-auto max-w-2xl text-[26px] leading-[1.1] tracking-[0.4px] text-white sm:text-[34px] md:text-heading-lg font-bold font-cal">
              Ready to streamline your visa caseload?
            </h2>
            <p class="mx-auto mt-4 max-w-md text-body text-blue-100">
              Get early access to Torii Immigration Assistant today — or talk to our engineers about a custom
              workflow for your consultancy.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
              <a href="/contact" class="btn-pill bg-blue-500 text-zinc-950 hover:bg-blue-400 font-bold shadow-lg">
                Join Torii Preview Waitlist →
              </a>
              <a href="/" class="btn-pill bg-white/10 border border-white/20 text-white hover:bg-white/20">
                Back to home
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
