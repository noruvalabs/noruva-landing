---
import Base from '../../layouts/Base.astro';
import { Header } from '../../components/site/header';
import { Footer } from '../../components/site/sections';
import { ArrowRight, Video, FileText, BarChart3, Users } from 'lucide-react';

const FEATURES = [
  {
    icon: "Video",
    title: "Live transcript capture",
    body: "Process live audio streams and extract speaker-separated transcripts in real time.",
  },
  {
    icon: "FileText",
    title: "Automated action item extraction",
    body: "Automatically identify commitments, tasks, owner tags, and deadlines as they are spoken.",
  },
  {
    icon: "BarChart3",
    title: "Executive debrief summaries",
    body: "Generate 1-page summaries linking decisions directly to paragraph-level transcript timestamps.",
  },
  {
    icon: "Users",
    title: "Project board sync",
    body: "Push extracted action items directly to Jira, Linear, Slack or Notion with one click.",
  },
];

const STEPS = [
  { n: "01", title: "Connect your meeting stream", body: "Invite Meeting Assistant to Zoom, Google Meet or Microsoft Teams calls with zero setup." },
  { n: "02", title: "Live transcript processing", body: "The engine parses live audio, separates speakers, and highlights key technical decisions." },
  { n: "03", title: "Extract tasks & action items", body: "Tasks, owners and target deadlines are extracted automatically during the conversation." },
  { n: "04", title: "Sync and debrief", body: "Produce a structured executive summary and push tasks directly to your team board." },
];
---

<Base
  title="Meeting Assistant — Noruva Labs"
  description="Live transcript processing, automated action item extraction, and executive meeting debriefs."
>
  <div class="min-h-screen overflow-x-clip bg-paper">
    <Header client:load />
    <main class="relative vertical-lines">
      <!-- Hero -->
      <section class="relative overflow-hidden pt-32 pb-20">
        <div class="pointer-events-none absolute inset-0 glow-purple" />
        <div class="container-page relative">
          <span class="inline-flex items-center gap-2 rounded-full bg-silver px-3 py-1 font-inter text-caption text-slate">
            <Video class="h-3.5 w-3.5 text-action-blue" />
            Meeting Assistant (Live)
          </span>
          <h1 class="mt-5 text-[32px] leading-[1.1] tracking-[0.4px] text-graphite sm:text-[42px] md:text-heading-lg lg:text-display font-bold font-cal">
            Turn long meetings into
            <br />
            instant action items
          </h1>
          <p class="mt-6 max-w-lg text-subheading text-slate">
            Capture live transcripts, extract owner assignments, generate executive debrief summaries,
            and push action items straight to your project tools.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="https://ai.noruvalabs.com" target="_blank" rel="noopener noreferrer" class="btn-pill btn-ink">
              Launch Live App (ai.noruvalabs.com) <ArrowRight class="h-4 w-4" />
            </a>
            <a href="#features" class="btn-pill btn-ghost">
              See features
            </a>
          </div>
        </div>
      </section>

      <div class="section-separator w-full" />

      <!-- Features -->
      <section id="features" class="container-page py-16 md:py-24">
        <div class="max-w-xl">
          <span class="inline-block rounded-full bg-silver px-3 py-1 font-inter text-caption tracking-[0.08em] text-slate uppercase font-bold">
            Features
          </span>
          <h2 class="mt-4 text-[28px] leading-[1.1] tracking-[0.4px] text-graphite sm:text-[36px] md:text-heading-lg font-bold font-cal">
            Meeting intelligence,
            <br />
            start to finish
          </h2>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2">
          {FEATURES.map((f) => (
            <article class="card-surface p-6 border-silver">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-silver/60">
                <Video class="h-4 w-4 text-action-blue" />
              </div>
              <h3 class="mt-4 text-heading-sm font-bold font-cal text-graphite">{f.title}</h3>
              <p class="mt-1.5 text-body-sm text-slate">{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <div class="section-separator w-full" />

      <!-- How it works -->
      <section class="container-page py-16 md:py-24">
        <div class="max-w-xl">
          <span class="inline-block rounded-full bg-silver px-3 py-1 font-inter text-caption tracking-[0.08em] text-slate uppercase font-bold">
            How it works
          </span>
          <h2 class="mt-4 text-[28px] leading-[1.1] tracking-[0.4px] text-graphite sm:text-[36px] md:text-heading-lg font-bold font-cal">
            Four steps to
            <br />
            actionable meeting summaries
          </h2>
        </div>
        <div class="mt-12 space-y-4">
          {STEPS.map((s) => (
            <article class="card-surface grid gap-6 p-6 md:grid-cols-[60px_1fr] border-silver">
              <span class="font-cal text-heading-lg text-action-blue font-bold">{s.n}</span>
              <div>
                <h3 class="text-heading font-bold font-cal text-graphite">{s.title}</h3>
                <p class="mt-2 text-body text-slate">{s.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <div class="section-separator w-full" />

      <!-- CTA -->
      <section id="cta" class="container-page pb-16 md:pb-24">
        <div class="relative overflow-hidden rounded-xl bg-action-blue/10 border border-action-blue/30 px-5 py-14 text-center sm:px-6 sm:py-20">
          <div class="relative">
            <h2 class="mx-auto max-w-2xl text-[26px] leading-[1.1] tracking-[0.4px] text-graphite sm:text-[34px] md:text-heading-lg font-bold font-cal">
              Ready to automate your meeting debriefs?
            </h2>
            <p class="mx-auto mt-4 max-w-md text-body text-slate">
              Try Meeting Assistant live today at ai.noruvalabs.com — or talk to our engineers about a custom
              workflow for your team.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
              <a href="https://ai.noruvalabs.com" target="_blank" rel="noopener noreferrer" class="btn-pill bg-action-blue text-white hover:opacity-90">
                Launch Live App (ai.noruvalabs.com) →
              </a>
              <a href="/" class="btn-pill border border-silver text-graphite hover:bg-silver/30">
                Back to home
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
